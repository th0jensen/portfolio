// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
  "lsp": {
    "just-lsp": {
      "initialization_options": {
        "rules": {
          "missing-dependencies": "off"
        }
      }
    }
  },
  "languages": {
    "TypeScript": {
      "tab_size": 2,
      "language_servers": [
          "!vtsls",
          "!eslint",
          "!typescript-language-server",
          "..."
      ],
      "formatter": "language_server",
      "format_on_save": "on",
      "prettier": { "allowed": false }
    },
    "JavaScript": {
      "tab_size": 2,
      "language_servers": [
          "!vtsls",
          "!eslint",
          "!typescript-language-server",
          "..."
      ],
      "formatter": "language_server",
      "format_on_save": "on",
      "prettier": { "allowed": false }
    },
    "TSX": {
      "tab_size": 2,
      "language_servers": [
          "!vtsls",
          "!eslint",
          "!typescript-language-server",
          "..."
      ],
      "formatter": "language_server",
      "format_on_save": "on",
      "prettier": { "allowed": false }
    },
    "CSS": {
      "language_servers": [
          "!vtsls",
          "!eslint",
          "!vscode-css-language-server",
          "..."
      ],
      "formatter": "language_server",
      "format_on_save": "on"
    },
    "HTML": {
      "language_servers": [
          "!vtsls",
          "..."
      ],
      "formatter": "language_server",
      "format_on_save": "on"
    }
  },
  "wrap_guides": [80],
  "soft_wrap": "bounded",
  "tab_size": 4,
  "show_whitespaces": "boundary"
}
